# Database
DATABASE_URL="postgresql://user:password@localhost:5432/activewear_store"

# Auth (admin)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Store branding (change when client decides)
NEXT_PUBLIC_STORE_NAME="Peak Activewear"
NEXT_PUBLIC_STORE_TAGLINE="Gear Up. Move Better."
NEXT_PUBLIC_STORE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Currency — PKR default for Pakistan, USD for international
NEXT_PUBLIC_DEFAULT_CURRENCY="pkr"
PKR_TO_USD_RATE="280"

# Shipping (in smallest currency unit: paisa for PKR, cents for USD)
SHIPPING_FLAT_RATE_CENTS_PKR="50000"
FREE_SHIPPING_THRESHOLD_CENTS_PKR="15000000"
SHIPPING_FLAT_RATE_CENTS_USD="1500"
FREE_SHIPPING_THRESHOLD_CENTS_USD="7500"

# Stripe (cards — Pakistan + international)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# CDN for product images
NEXT_PUBLIC_CDN_BASE_URL="https://cdn.example.com"

# Notifications (optional)
RESEND_API_KEY=""
RESEND_FROM=""
ORDER_NOTIFY_WHATSAPP=""

# Seed admin
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe2026!"
SEED_ADMIN_NAME="Store Admin"
