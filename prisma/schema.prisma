generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
}

enum ProductBadge {
  NEW
  BEST_SELLER
  SALE
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  COD
  CARD
  JAZZCASH
  EASYPAISA
}

enum AdminRole {
  ADMIN
  STAFF
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  tagline        String
  description    String
  material       String?
  gender         Gender         @default(UNISEX)
  categoryId     String?
  category       Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  badge          ProductBadge?
  rating         Float          @default(0)
  reviewCount    Int            @default(0)
  featured       Boolean        @default(false)
  status         ProductStatus  @default(DRAFT)
  /// Cached min PKR price for sorting/filtering
  priceCentsPkr  Int            @default(0)
  /// Cached min USD price for sorting/filtering
  priceCentsUsd  Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  variants       ProductVariant[]
  images         ProductImage[]
  reviews        Review[]
  orderItems     OrderItem[]

  @@index([status, featured])
  @@index([categoryId])
  @@index([priceCentsPkr])
}

model ProductVariant {
  id                String         @id @default(cuid())
  productId         String
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorName         String
  colorSlug         String
  colorHex          String?
  sku               String?
  priceCentsPkr     Int
  priceCentsUsd     Int
  compareAtCentsPkr Int?
  compareAtCentsUsd Int?
  sizes             String[]
  /// Per-size qty, e.g. { "S": 4, "M": 8 }
  sizeStock         Json           @default("{}")
  stock             Int            @default(0)
  position          Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  images            ProductImage[]
  orderItems        OrderItem[]

  @@unique([productId, colorSlug])
  @@index([productId, position])
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  label     String          @default("")
  position  Int             @default(0)

  @@index([productId, position])
  @@index([variantId, position])
}

model Review {
  id         String   @id @default(cuid())
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int
  title      String?
  body       String
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([approved, createdAt])
  @@index([productId])
}

model Order {
  id                    String        @id @default(cuid())
  orderNumber           String        @unique
  email                 String
  name                  String
  phone                 String?
  addressLine1          String
  addressLine2          String?
  city                  String
  state                 String?
  postalCode            String
  country               String        @default("")
  currency              String        @default("pkr")
  subtotalCents         Int
  shippingCents         Int
  totalCents            Int
  status                OrderStatus   @default(PENDING)
  paymentMethod         PaymentMethod @default(COD)
  stripePaymentIntentId String?       @unique
  notes                 String?
  clientIp              String?
  geoCountry            String?
  geoRegion             String?
  geoCity               String?
  userAgent             String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  items                 OrderItem[]

  @@index([status, createdAt])
  @@index([orderNumber])
  @@index([email])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  productSlug String
  colorName   String?
  priceCents  Int
  size        String
  quantity    Int

  @@index([orderId])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum CustomOrderStatus {
  NEW
  QUOTED
  CONFIRMED
  IN_PRODUCTION
  SHIPPED
  DONE
  CANCELLED
}

/// Team / custom merch quote requests (names, numbers, logos).
model CustomOrder {
  id              String            @id @default(cuid())
  reference       String            @unique
  name            String
  email           String
  phone           String
  organization    String?
  productType     String
  quantity        Int
  sizeBreakdown   String?
  fabricId        String?
  printNames      Boolean           @default(false)
  printNumbers    Boolean           @default(false)
  printLogo       Boolean           @default(false)
  placement       String?
  colorPreference String?
  deadline        String?
  notes           String?
  logoUrl         String?
  status          CustomOrderStatus @default(NEW)
  quotedPricePkr  Int?
  adminNotes      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([email])
}
